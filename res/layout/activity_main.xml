<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/dock_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/home_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingTop="12dp"
                android:paddingEnd="24dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/header_wallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/clock_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/time_display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/cmu_serif"
                        android:letterSpacing="-0.04"
                        android:textColor="@color/ink"
                        android:textSize="70sp"
                        tools:text="10:54" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/date_line"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lora_it"
                            android:textColor="@color/ink"
                            android:textSize="14sp"
                            tools:text="Monday, 30 March 2026" />

                        <TextView
                            android:id="@+id/greeting_line"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lora_it"
                            android:textColor="@color/muted"
                            android:textSize="13sp"
                            tools:text="Good evening, snes." />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/wx_block"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/wx_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/cmu_serif"
                            android:letterSpacing="-0.02"
                            android:textColor="@color/ink"
                            android:textSize="27sp"
                            tools:text="4°C" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/wx_cond"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/lora_it"
                                android:textColor="@color/muted"
                                android:textSize="13sp"
                                tools:text="Overcast, light wind" />

                            <TextView
                                android:id="@+id/wx_loc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:fontFamily="@font/inter"
                                android:letterSpacing="0.2"
                                android:textAllCaps="true"
                                android:textColor="@color/muted"
                                android:textSize="9sp"
                                tools:text="TORONTO, ON" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/ornament_rule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="2dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/rule_light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:fontFamily="@font/cmu_serif"
                    android:text="✦"
                    android:textColor="@color/rule"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/rule_light" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/main_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:id="@+id/calendar_col"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:letterSpacing="0.2"
                            android:text="CALENDAR"
                            android:textAllCaps="true"
                            android:textColor="@color/muted"
                            android:textSize="10sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:baselineAligned="true"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/cal_month"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/cmu_serif"
                                android:textColor="@color/ink"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/cal_year"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/lora_it"
                                android:textColor="@color/muted"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/cal_grid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/inter"
                                android:letterSpacing="0.2"
                                android:text="EVENTS"
                                android:textAllCaps="true"
                                android:textColor="@color/muted"
                                android:textSize="10sp" />

                            <LinearLayout
                                android:id="@+id/ev_pager"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="invisible">

                                <TextView
                                    android:id="@+id/btn_ev_prev"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:background="@drawable/bg_border_outline"
                                    android:gravity="center"
                                    android:text="◂"
                                    android:textColor="@color/muted" />

                                <TextView
                                    android:id="@+id/ev_indicator"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="8dp"
                                    android:fontFamily="@font/inter"
                                    android:letterSpacing="0.1"
                                    android:textColor="@color/muted"
                                    android:textSize="12sp"
                                    android:text="1 / 2" />

                                <TextView
                                    android:id="@+id/btn_ev_next"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:background="@drawable/bg_border_outline"
                                    android:gravity="center"
                                    android:text="▸"
                                    android:textColor="@color/muted" />
                            </LinearLayout>
                        </RelativeLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/events_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>

                    <com.snes19xx.einklauncher.DrawingView
                        android:id="@+id/drawing_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:id="@+id/drawing_controls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_draw_save"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_border_outline"
                            android:gravity="center"
                            android:text="✓"
                            android:textColor="@color/ink"
                            android:visibility="gone"
                            android:layout_marginEnd="4dp"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btn_draw_clear"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_border_outline"
                            android:gravity="center"
                            android:text="✕"
                            android:textColor="@color/muted"
                            android:visibility="gone"
                            android:layout_marginEnd="4dp"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btn_draw_toggle"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:text="✍"
                            android:textColor="@color/muted"
                            android:textSize="14sp" />
                    </LinearLayout>

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/widget_col"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/photo_widget_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_border_outline"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:padding="1dp">

                            <ImageView
                                android:id="@+id/photo_widget"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop" />
                        </FrameLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pdf_widget_container"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:background="@drawable/bg_border_outline"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/inter"
                                android:letterSpacing="0.2"
                                android:text="RECENT PDFS"
                                android:textAllCaps="true"
                                android:textColor="@color/muted"
                                android:textSize="10sp" />
                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/rule_light" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/pdf_grid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/rule_light"
                            android:padding="1dp" />

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shelf_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="8dp"
                android:paddingBottom="24dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/rule_light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:letterSpacing="0.2"
                    android:text="Library"
                    android:textAllCaps="true"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/books_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/dock_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/rule_light" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/dock_items_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>